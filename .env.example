# Existing public Sanity configuration; preserve the production dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=aqtsgm5o
NEXT_PUBLIC_SANITY_DATASET=production
# Set these only in the deployment environment. Never commit real secret values.
SANITY_API_WRITE_TOKEN=
AUDIT_WEBHOOK_SECRET=
# Official social links and Discord invite are maintained in src/lib/community.ts.
# XGamer private operations. Populate only in deployment settings, never source.
DATABASE_URL=
PRIVATE_DATA_KEY=
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=https://xgamer-league-web.vercel.app
APP_ORIGIN=https://xgamer-league-web.vercel.app
MAIN_ADMIN_DISCORD_IDS=
REGISTRATION_ENABLED=false
# XGamer LIVE (optional, server-side only). Without a platform's keys its card shows "Unavailable".
# YouTube Data API key; channel ID (UC…) optional — otherwise found from @XGamerProLeague.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Twitch app (dev.twitch.tv/console) — client credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick app (kick.com developer settings) — client credentials.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
