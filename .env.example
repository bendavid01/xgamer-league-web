# Existing public Sanity configuration; preserve the production dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=aqtsgm5o
NEXT_PUBLIC_SANITY_DATASET=production
# Set these only in the deployment environment. Never commit real secret values.
SANITY_API_WRITE_TOKEN=
AUDIT_WEBHOOK_SECRET=
# Official social links and Discord invite are maintained in src/lib/community.ts.
# XGamer private operations. Populate only in deployment settings, never source.
DATABASE_URL=
PRIVATE_DATA_KEY=
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_URL=https://xgamerproleague.vercel.app
APP_ORIGIN=https://xgamerproleague.vercel.app
MAIN_ADMIN_DISCORD_IDS=
REGISTRATION_ENABLED=false
# XG player sign-in (/api/player/*). Signs the xg_player_session cookie with HMAC-SHA256.
# A random value of at least 32 characters, e.g. `openssl rand -hex 32`, set only in deployment
# settings and different from AUTH_SECRET and PRIVATE_DATA_KEY. There is no fallback: without it,
# player sign-in answers 503 in every environment. Changing it signs every player out.
PLAYER_SESSION_SECRET=
# XGamer LIVE (optional, server-side only). Without a platform's keys its card shows "Unavailable".
# YouTube Data API key; channel ID (UC…) optional — otherwise found from @XGamerProLeague.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Twitch app (dev.twitch.tv/console) — client credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick app (kick.com developer settings) — client credentials.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
